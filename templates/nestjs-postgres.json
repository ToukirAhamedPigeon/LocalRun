{
  "$schema": "https://raw.githubusercontent.com/ToukirAhamedPigeon/LocalRun/main/schema/localrun.schema.json",
  "name": "NestJS API + PostgreSQL",
  "checks": [
    { "exists": ".env", "fix": "Copy .env.example to .env and set DATABASE_URL" }
  ],
  "setup": [
    { "name": "npm ci", "run": "npm ci", "when": { "missing": "node_modules" } }
  ],
  "services": [
    { "name": "postgres", "run": "docker run --rm --name nest-postgres -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16",
      "stop": "docker stop nest-postgres", "port": 5432, "shared": true, "ready": { "log": "ready to accept connections", "timeout": 120 } },
    { "name": "migrate", "run": "npx prisma migrate deploy", "ready": { "exit": true } },
    { "name": "api", "run": "npm run start:dev", "port": 3000, "ready": { "url": "http://127.0.0.1:3000", "timeout": 120 } }
  ],
  "open": ["http://localhost:3000"]
}
